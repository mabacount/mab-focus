{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mab-Focus",
  "version": "0.1.0",
  "identifier": "com.mabfocus.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mab-Focus — Dashboard",
        "label": "main",
        "url": "/",
        "width": 1150,
        "height": 760,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": true
      },
      {
        "title": "Mab-Focus Widget",
        "label": "widget",
        "url": "/widget.html",
        "width": 260,
        "height": 68,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}